<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ViewRooms.aspx.cs" Inherits="Hotel_Room_Booking_Management_System.ViewRooms" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Hotel Booking | Available Rooms</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f4f6fa;
            color: #26354b;
            margin: 0;
        }

        /* Navigation */
        .navbar-custom {
            background: #14243e;
            padding: 16px 0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .navbar-brand {
            color: #ffffff !important;
            font-size: 21px;
            font-weight: 700;
            text-decoration: none;
        }

        .brand-icon {
            color: #c59d5f;
            margin-right: 8px;
        }

        .nav-caption {
            color: #cbd5e1;
            font-size: 12px;
        }

        /* Main container */
        .main-container {
            max-width: 1200px;
            margin: auto;
            padding: 35px 20px;
        }

        .page-heading {
            color: #172b49;
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-description {
            color: #7b8492;
            font-size: 13px;
            line-height: 1.8;
        }

        /* Banner */
        .welcome-banner {
            background: linear-gradient(120deg, #172b49, #304e70);
            color: white;
            padding: 28px 30px;
            border-radius: 15px;
            margin-bottom: 28px;
            box-shadow: 0 8px 25px rgba(20, 36, 62, 0.10);
        }

            .welcome-banner h2 {
                font-size: 21px;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .welcome-banner p {
                color: #d8e1ed;
                font-size: 13px;
                margin-bottom: 0;
                line-height: 1.8;
            }

        .banner-icon {
            font-size: 48px;
            text-align: center;
        }

        /* Rooms table card */
        .table-card {
            background: white;
            border: 1px solid #edf0f5;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 25px rgba(20, 36, 62, 0.05);
        }

        .section-heading {
            color: #172b49;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .section-description {
            color: #8791a0;
            font-size: 12px;
            margin-bottom: 22px;
        }

        .table-responsive {
            border-radius: 10px;
            overflow-x: auto;
        }

        /* GridView styling */
        .rooms-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
            background: white;
            font-size: 13px;
        }

            .rooms-grid th {
                background: #172b49;
                color: white;
                padding: 15px 14px;
                text-align: left;
                white-space: nowrap;
                font-weight: 500;
                border: none;
            }

            .rooms-grid td {
                padding: 14px;
                border-bottom: 1px solid #edf0f5;
                color: #526176;
                vertical-align: middle;
                white-space: nowrap;
            }

            .rooms-grid tr:nth-child(even) td {
                background: #f8fafd;
            }

            .rooms-grid tr:hover td {
                background: #f0f4fa;
            }

            .rooms-grid tr:last-child td {
                border-bottom: none;
            }

            /* Select button generated by GridView */
            .rooms-grid input[type="submit"],
            .rooms-grid input[type="button"],
            .rooms-grid input[type="image"],
            .rooms-grid a {
                display: inline-block;
                background: #c59d5f;
                color: white !important;
                border: none;
                border-radius: 6px;
                padding: 7px 14px;
                font-family: 'Poppins', sans-serif;
                font-size: 12px;
                font-weight: 500;
                text-decoration: none;
                cursor: pointer;
            }

                .rooms-grid input[type="submit"]:hover,
                .rooms-grid input[type="button"]:hover,
                .rooms-grid a:hover {
                    background: #ad8448;
                }

        /* Footer */
        .footer {
            text-align: center;
            padding: 22px 15px;
            color: #8791a0;
            font-size: 11px;
        }

        @media (max-width: 767px) {
            .main-container {
                padding: 24px 14px;
            }

            .page-heading {
                font-size: 24px;
            }

            .welcome-banner {
                padding: 24px 20px;
            }

                .welcome-banner h2 {
                    font-size: 19px;
                }

            .banner-icon {
                font-size: 35px;
                text-align: left;
                margin-top: 15px;
            }

            .table-card {
                padding: 17px;
            }

            .navbar-brand {
                font-size: 18px;
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <!-- Navigation Bar -->
        <nav class="navbar navbar-custom">
            <div class="container">
                <a class="navbar-brand" href="Home.aspx">
                    <span class="brand-icon">&#127976;</span>
                    Luxury Stay
                </a>

                <div class="text-end">
                    <nav class="navbar navbar-expand-lg navbar-dark"
                        style="background-color: #14243e; padding: 15px;">

                        <div class="container-fluid">



                            <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#hotelNavbar">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <div class="collapse navbar-collapse" id="hotelNavbar">

                                <ul class="navbar-nav ms-auto">

                                    <li class="nav-item">
                                        <a class="nav-link" href="Home.aspx">Home</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" href="ViewRooms.aspx">View Rooms
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" href="Profile.aspx">Profile
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" href="Login.aspx">Logout
                                        </a>
                                    </li>

                                </ul>

                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-container">

            <!-- Page Heading -->
            <div class="mb-4">
                <h1 class="page-heading">Explore Our Rooms</h1>

                <p class="page-description">
                    Discover available accommodation and select a room
                    that suits your requirements.
                </p>
            </div>

            <!-- Welcome Banner -->
            <div class="welcome-banner">
                <div class="row align-items-center">

                    <div class="col-md-10">
                        <h2>Find Your Perfect Stay</h2>

                        <p>
                            Browse room details, compare room types and prices,
                            and select your preferred room to continue.
                        </p>
                    </div>

                    <div class="col-md-2">
                        <div class="banner-icon">&#127976;</div>
                    </div>

                </div>
            </div>

            <!-- Rooms GridView -->
            <div class="table-card">

                <h2 class="section-heading">Room Availability</h2>

                <p class="section-description">
                    Review the room information below and click Select
                    to proceed with your chosen room.
                </p>

                <div class="table-responsive">

                    <asp:GridView ID="gvViewRooms" runat="server"
                        CssClass="rooms-grid"
                        AutoGenerateColumns="true"
                        AutoGenerateSelectButton="true"
                        DataKeyNames="RoomId"
                        OnSelectedIndexChanged="gvViewRooms_SelectedIndexChanged"
                        GridLines="None"
                        CellPadding="0"
                        EmptyDataText="No rooms are available to display at the moment.">
                    </asp:GridView>

                </div>

            </div>

        </main>

        <!-- Footer -->
        <footer class="footer">
            &copy; 2026 Luxury Stay | Hotel Room Booking Management System
        </footer>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
